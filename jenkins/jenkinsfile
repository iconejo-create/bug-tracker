pipeline {
    agent any

    tools{
        go '1.26.2'
        nodejs '26.10'
    }

    stages {
        stage('Unit-test Backend') {
            steps {
                dir('bugtracker-backend'){
                    sh 'go test -v ./... 2>&1 | go-junit-report > test-results.xml'
                }
            }
            post{
                always{
                    junit 'bugtracker-backend/test-results.xml'
                }
            }
        }
        stage('Unit-test Frontend'){
            agent{
                docker{
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps{
                dir('bugtracker-frontend'){
                    sh '''
                        npm ci
                        npm test
                    '''
                }
            }
        }
        stage('Launch App'){
            agent{
                docker{
                    image 'docker:27.5.1'
                    reuseNode true
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u 0'
                }
            }
            steps{
                sh 'docker compose up --build -d'
            }
        }

        stage ('API Tests') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    args '-u 0 --network=host'
                }
            }
            steps{
                dir('tests-api'){
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000'

                    sh 'npm ci'
                    sh 'npx playwright test'
                }
            }
        }
        stage('K6 Performance test'){
            agent{
                docker{
                    image 'grafana/k6:latest'
                    reuseNode true
                    args '--network=host -u root --entrypoint ""'
                }
            }
            steps{
                dir('tests-perf'){
                    sh 'k6 run script.js'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
