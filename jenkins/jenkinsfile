pipeline {
    agent any

    tools{
        go '1.26.2'
        nodejs '26.10'
    }

    stages {
        stage('Unit-test Backend') {
            steps {
                dir('bugtracker-backend'){
                    sh 'go test -v ./...'
                }


            }
        }
        stage('Unit-test Frontend'){
            agent{
                docker{
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps{
                dir('bugtracker-frontend'){
                    sh '''
                        npm ci
                        npm test
                    '''
                }
            }
        }
        stage('K6 Performance test'){
            agent{
                docker{
                    image 'grafana/k6:latest'
                    reuseNode true
                    args '--network=host -u root --entrypoint""'
                }
            }
            steps{
                dir('tests-perf'){
                    sh 'k6 run script.js'
                }
            }
        }
    }
}
